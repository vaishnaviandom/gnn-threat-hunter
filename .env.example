# ── Shared ──────────────────────────────────────────────────────────
# Copy this file to .env and fill in all values.
# NEVER commit .env to Git.

# ── PostgreSQL (Django backend) ──────────────────────────────────────
POSTGRES_DB=gnn_threatdb
POSTGRES_USER=gnn_user
POSTGRES_PASSWORD=change_me_now
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Redpanda (Kafka-compatible broker) ───────────────────────────────
REDPANDA_BOOTSTRAP_SERVERS=localhost:19092
REDPANDA_TOPIC_TELEMETRY=ocsf.telemetry.raw
REDPANDA_TOPIC_GRAPH_EDGES=graph.edges.v1

# ── Memgraph ─────────────────────────────────────────────────────────
MEMGRAPH_HOST=localhost
MEMGRAPH_PORT=7687
MEMGRAPH_USERNAME=
MEMGRAPH_PASSWORD=

# ── ClickHouse (analytics store) ─────────────────────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=threat_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ── Django ───────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Inference service ────────────────────────────────────────────────
INFERENCE_SERVICE_URL=http://localhost:8001
INFERENCE_BATCH_MAX=32
INFERENCE_BATCH_TIMEOUT_MS=50

# ── Solana ───────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=REPLACE_WITH_DEPLOYED_PROGRAM_ID
SOLANA_KEYPAIR_PATH=~/.config/solana/id.json

# ── Next.js ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_INFERENCE_URL=http://localhost:8001/api
NEXT_PUBLIC_SOLANA_NETWORK=devnet
